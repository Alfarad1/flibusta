# Copy to .env.stack or pass --env-file ../../.env from repo root (POSTGRES_USER is read for DB admin init).
# Used by docker-compose.stack.yml

APPUSER_PUID=1000
APPUSER_PGID=1000
TIME_ZONE_VALUE=Europe/Moscow

# If not using root .env, set the same values as infrastructure/postgres:
# POSTGRES_USER=appuser

# Полка «На Kindle»: книги с неё выкладываются в папку WebDAV, откуда их забирает KOReader.
# Полка появляется только у пользователя FLIBUSTA_KINDLE_USER (имя на сайте). Пусто — выключено.
# FLIBUSTA_KINDLE_USER=George
# FLIBUSTA_WEBDAV_URL=https://cloud.example.com/seafdav
# FLIBUSTA_WEBDAV_USER=me@example.com
# FLIBUSTA_WEBDAV_PASSWORD=webdav-password
# FLIBUSTA_WEBDAV_DIR=My Library/Kindle
