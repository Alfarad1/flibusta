# Copy to .env.stack or pass --env-file ../../.env from repo root (POSTGRES_USER is read for DB admin init).
# Used by docker-compose.stack.yml

APPUSER_PUID=1000
APPUSER_PGID=1000
TIME_ZONE_VALUE=Europe/Moscow

# If not using root .env, set the same values as infrastructure/postgres:
# POSTGRES_USER=appuser
